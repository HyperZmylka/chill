# Adres, pod którym użytkownicy otwierają Chill. Bez ukośnika na końcu.
# Dla HTTPS podaj domenę, np. https://chill.example.com
CHILL_PUBLIC_URL=https://chill.example.com

# Port na hoście, na którym działa kontener (domyślnie 47830).
CHILL_HTTP_PORT=47830

# Adres nasłuchiwania portu na hoście. Ustaw 127.0.0.1, jeśli przed kontenerem
# działa Caddy lub inny reverse proxy i port nie ma być widoczny z internetu.
CHILL_BIND_ADDRESS=0.0.0.0
