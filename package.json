{
  "name": "yapper-chat",
  "productName": "Yapper Chat",
  "version": "2.0.0",
  "description": "Nowoczesny komunikator - lepszy, ładniejszy, szybszy",
  "main": "main.js",
  "private": true,
  "author": "You",
  "homepage": "https://yapper-chat.local",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "chat.yapper.desktop",
    "productName": "Yapper Chat",
    "copyright": "Copyright © 2026",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "publisherName": "Yapper Chat",
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yapper Chat",
      "menuCategory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "build/icon.png",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      }
    ]
  },
  "allowScripts": {
    "electron@29.4.6": true
  }
}
