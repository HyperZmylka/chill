{
  "name": "chill",
  "productName": "Chill",
  "version": "4.2.0",
  "description": "Chill — spokojny komunikator desktopowy: serwery, kanały, wiadomości prywatne, emoji i aktualizacje.",
  "main": "main.js",
  "private": true,
  "author": "HyperZmylka",
  "homepage": "https://github.com/HyperZmylka/chill",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.chill.desktop",
    "productName": "Chill",
    "copyright": "Copyright © 2026 HyperZmylka",
    "artifactName": "Chill-Setup-${version}.exe",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "sign": null
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chill",
      "menuCategory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "gifs.js",
      "build/icon.png",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      }
    ]
  },
  "allowScripts": {
    "electron@29.4.6": true
  }
}
